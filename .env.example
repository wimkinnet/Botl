# Copy to .env for local development (npm run dev reads it via node --env-file).
# MongoDB Atlas: Database > Connect > Drivers, then add the database name (botl) before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/botl?retryWrites=true&w=majority
# Optional: when set, the browser asks for this password before showing Botl (any user name works).
APP_PASSWORD=
PORT=3000
